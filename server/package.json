{
  "name": "@label-extractor/server",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API process and background worker process (two entrypoints, one codebase).",
  "type": "module",
  "scripts": {
    "dev:api": "node --watch --env-file-if-exists=.env src/api/main.ts",
    "dev:worker": "node --watch --env-file-if-exists=.env src/worker/main.ts",
    "start:api": "node --env-file-if-exists=.env src/api/main.ts",
    "start:worker": "node --env-file-if-exists=.env src/worker/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@label-extractor/shared": "^0.0.0",
    "@supabase/supabase-js": "^2.117.1",
    "fastify": "^5.12.5",
    "openai": "^7.23.0",
    "pg-boss": "^12.34.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9"
  }
}
