# Copy to server/.env and fill in. Both the API and the worker read this file in development.
# In production, set these as environment variables on each service instead.

# ---- Shared by API and worker --------------------------------------------------------------
# Postgres connection. Locally: the URL printed by `supabase start` (DB_URL).
# On hosted Supabase: use the *session pooler* URI (IPv4-compatible, port 5432).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Connections per process for app queries (pg-boss keeps its own pool of 3 on top).
DATABASE_POOL_MAX=5

# Supabase API URL and a *server-side* key (sb_secret_… or the legacy service_role key).
# Locally: API_URL and SECRET_KEY from `supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=labels
# Only if browsers reach Supabase at a different address than the server (compose.yaml sets it).
# SUPABASE_PUBLIC_URL=http://127.0.0.1:54321

LOG_LEVEL=info

# ---- API only ------------------------------------------------------------------------------
PORT=3000
# Set to the built web app (e.g. ../web/dist) to have the API serve the UI too — used in production.
# WEB_DIST_DIR=../web/dist

# ---- Worker only ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=90000
WORKER_CONCURRENCY=4
# Requests per minute to OpenAI across ALL workers together (a shared limiter). Set it to your
# key's limit; more workers than this rate can feed just wait their turn.
OPENAI_REQUESTS_PER_MINUTE=120
# The worker serves only GET /api/health, on this port (hosts like Railway set PORT themselves).
# PORT=3001
